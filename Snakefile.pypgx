# ft: python
import glob
import pandas as pd
import os
import zipfile
import io
import csv

# Load config
configfile: "config.yaml"

PYPGX_VERSION = "0.26.0"

# Read genes from the BED file specified in the config
bed_file_path = config["target_genes"]
with open(bed_file_path) as f:
    GENES = sorted(list(set([line.strip() for line in f if line.strip()])))

rule all:
    input:
        "results/pgx/merged_alleles.csv",
        "results/pgx/merged_genotypes.csv",
        "results/pgx/merged_phenotypes.csv"

rule download_bundle:
    output:
        directory("resources/pypgx-bundle")
    params:
        version=PYPGX_VERSION
    shell:
        "git clone --branch {params.version} --depth 1 https://github.com/sbslee/pypgx-bundle {output}"

rule generate_groups:
    input: samples=config["sample_info"]
    output: "results/temp/pgx_groups.txt"
    shell:
        "python scripts/generate_groups.py {input.samples} {output}"

rule create_target_bed:
    input:
        vcf=config["input_vcf"],
        genes=config["target_genes"],
        bundle=rules.download_bundle.output
    output:
        bed="results/temp/target_regions.bed"
    run:
        from cyvcf2 import VCF
        import subprocess

        vcf = VCF(str(input.vcf))
        has_chr = any(seq.startswith("chr") for seq in vcf.seqnames)
        vcf.close()

        with open(str(input.genes)) as f:
            genes = [line.strip() for line in f if line.strip()]

        cmd = [
            "pypgx", "create-regions-bed",
            "--assembly", "GRCh38",
            "--genes"
        ] + genes

        if has_chr:
            cmd.append("--add-chr-prefix")

        env = dict(os.environ, PYPGX_BUNDLE=str(input.bundle))
        with open(str(output.bed), "w") as out_f:
            subprocess.run(cmd, stdout=out_f, env=env, check=True)

rule extract_target_genes:
    input:
        vcf=config["input_vcf"],
        bed=rules.create_target_bed.output.bed
    output:
        vcf=temp("results/temp/target_genes_raw.vcf.gz")
    shell:
        "bcftools view -R {input.bed} -O z -o {output.vcf} {input.vcf}"

rule format_vcf_for_pypgx:
    input:
        vcf=rules.extract_target_genes.output.vcf
    output:
        vcf="results/temp/preprocessed_for_pypgx.vcf.gz",
        tbi="results/temp/preprocessed_for_pypgx.vcf.gz.tbi"
    shell:
        """
        # Workaround: PyPGX run-ngs-pipeline crashes on bcftools-normalized VCF files
        # when it encounters comma-separated missing values in the format fields 
        # (e.g. AD=".,." for masked/missing genotypes). This cyvcf2 script normalizes any
        # all-missing AD vector to a single "." using HTSlib vector-end encoding.
        python scripts/preprocess_vcf_for_pypgx.py {input.vcf} {output.vcf}
        """

rule run_pypgx:
    input:
        vcf="results/temp/preprocessed_for_pypgx.vcf.gz",
        tbi="results/temp/preprocessed_for_pypgx.vcf.gz.tbi",
        bundle=rules.download_bundle.output
    output:
        "results/pgx/{gene}/results.zip"
    threads: 1
    shell:
        """
        export PYPGX_BUNDLE={input.bundle}
        pypgx run-ngs-pipeline \
            --assembly GRCh38 \
            --variants {input.vcf} \
            --force \
            {wildcards.gene} \
            $(dirname {output})
        """

rule calculate_stratified_af:
    input:
        zip="results/pgx/{gene}/results.zip",
        groups="results/temp/pgx_groups.txt"
    output:
        alleles="results/pgx/af/{gene}_alleles.csv",
        genotypes="results/pgx/af/{gene}_genotypes.csv",
        phenotypes="results/pgx/af/{gene}_phenotypes.csv"
    shell:
        """
        python scripts/calculate_pgx_stats.py \
            --zip {input.zip} \
            --groups {input.groups} \
            --gene {wildcards.gene} \
            --out-alleles {output.alleles} \
            --out-genotypes {output.genotypes} \
            --out-phenotypes {output.phenotypes}
        """

rule merge_alleles:
    input: expand("results/pgx/af/{gene}_alleles.csv", gene=GENES)
    output: "results/pgx/merged_alleles.csv"
    run:
        for f in input:
            if not os.path.exists(f) or os.path.getsize(f) == 0:
                raise ValueError(f"Corrupt or empty file detected: '{f}'. Upstream calculation failed.")
        pd.concat([pd.read_csv(f) for f in input]).to_csv(output[0], index=False)

rule merge_genotypes:
    input: expand("results/pgx/af/{gene}_genotypes.csv", gene=GENES)
    output: "results/pgx/merged_genotypes.csv"
    run:
        for f in input:
            if not os.path.exists(f) or os.path.getsize(f) == 0:
                raise ValueError(f"Corrupt or empty file detected: '{f}'. Upstream calculation failed.")
        pd.concat([pd.read_csv(f) for f in input]).to_csv(output[0], index=False)

rule merge_phenotypes:
    input: expand("results/pgx/af/{gene}_phenotypes.csv", gene=GENES)
    output: "results/pgx/merged_phenotypes.csv"
    run:
        for f in input:
            if not os.path.exists(f) or os.path.getsize(f) == 0:
                raise ValueError(f"Corrupt or empty file detected: '{f}'. Upstream calculation failed.")
        pd.concat([pd.read_csv(f) for f in input]).to_csv(output[0], index=False)
