# ft: python
import glob
import pandas as pd
import os
import zipfile
import io
import csv

# Load config
configfile: "config.yaml"

PYPGX_VERSION = "0.26.0"

# Read genes from the BED file specified in the config
bed_file_path = config["regions_bed"]
with open(bed_file_path) as f:
    GENES = sorted(list(set([line.strip().split("\t")[3] for line in f if line.strip()])))

# Read PyPGX supported genes
with open("resources/pypgx_genes.txt") as f:
    PYPGX_GENES = sorted(list(set([line.strip() for line in f])))

# Remove unsupported genes
GENES = [g for g in GENES if g in PYPGX_GENES]

rule all:
    input:
        "results/pgx/merged_alleles.csv",
        "results/pgx/merged_genotypes.csv",
        "results/pgx/merged_phenotypes.csv"

rule download_bundle:
    output:
        directory("resources/pypgx-bundle")
    shell:
        "git clone --branch {PYPGX_VERSION} --depth 1 https://github.com/sbslee/pypgx-bundle {output}"

rule generate_groups:
    input: samples=config["sample_info"]
    output: "results/temp/pgx_groups.txt"
    shell:
        "python scripts/generate_groups.py {input.samples} {output}"

rule run_pypgx:
    input:
        vcf=config["input_vcf"],
        bundle=rules.download_bundle.output
    output:
        "results/pgx/{gene}/results.zip"
    threads: 1
    shell:
        """
        export PYPGX_BUNDLE={input.bundle}
        pypgx run-ngs-pipeline \
            --assembly GRCh38 \
            --variants {input.vcf} \
            --force \
            {wildcards.gene} \
            $(dirname {output})
        """

rule calculate_stratified_af:
    input:
        zip="results/pgx/{gene}/results.zip",
        groups="results/temp/pgx_groups.txt"
    output:
        alleles="results/pgx/af/{gene}_alleles.csv",
        genotypes="results/pgx/af/{gene}_genotypes.csv",
        phenotypes="results/pgx/af/{gene}_phenotypes.csv"
    shell:
        """
        python scripts/calculate_pgx_stats.py \
            --zip {input.zip} \
            --groups {input.groups} \
            --gene {wildcards.gene} \
            --out-alleles {output.alleles} \
            --out-genotypes {output.genotypes} \
            --out-phenotypes {output.phenotypes}
        """

rule merge_alleles:
    input: expand("results/pgx/af/{gene}_alleles.csv", gene=GENES)
    output: "results/pgx/merged_alleles.csv"
    run: pd.concat([pd.read_csv(f) for f in input]).to_csv(output[0], index=False)

rule merge_genotypes:
    input: expand("results/pgx/af/{gene}_genotypes.csv", gene=GENES)
    output: "results/pgx/merged_genotypes.csv"
    run: pd.concat([pd.read_csv(f) for f in input]).to_csv(output[0], index=False)

rule merge_phenotypes:
    input: expand("results/pgx/af/{gene}_phenotypes.csv", gene=GENES)
    output: "results/pgx/merged_phenotypes.csv"
    run: pd.concat([pd.read_csv(f) for f in input]).to_csv(output[0], index=False)
