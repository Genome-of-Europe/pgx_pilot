# ft: python
import glob
import pandas as pd
import os
import zipfile
import io
import csv

# Load config
configfile: "config.yaml"

PYPGX_VERSION = "0.26.0"

# Read genes from the BED file specified in the config
bed_file_path = config["regions_bed"]
with open(bed_file_path) as f:
    GENES = sorted(list(set([line.strip().split("\t")[3] for line in f if line.strip()])))

# Read PyPGX supported genes
with open("resources/pypgx_genes.txt") as f:
    PYPGX_GENES = sorted(list(set([line.strip() for line in f])))

# Remove unsupported genes
GENES = [g for g in GENES if g in PYPGX_GENES]

rule all:
    input:
        "results/pgx/merged_alleles.csv",
        "results/pgx/merged_genotypes.csv",
        "results/pgx/merged_phenotypes.csv"

rule download_bundle:
    output:
        directory("resources/pypgx-bundle")
    shell:
        "git clone --branch {PYPGX_VERSION} --depth 1 https://github.com/sbslee/pypgx-bundle {output}"

rule generate_metadata:
    input: samples=config["sample_info"]
    output: "results/temp/pgx_groups.txt"
    shell:
        "python scripts/generate_groups.py {input.samples} {output}"

rule run_pypgx:
    input:
        vcf=config["input_vcf"],
        bundle=rules.download_bundle.output
    output:
        "results/pgx/{gene}/results.zip"
    threads: 1
    shell:
        """
        export PYPGX_BUNDLE={input.bundle}
        pypgx run-ngs-pipeline \
            --assembly GRCh38 \
            --variants {input.vcf} \
            --force \
            {wildcards.gene} \
            $(dirname {output})
        """

rule calculate_stratified_af:
    input:
        zip="results/pgx/{gene}/results.zip",
        groups="results/temp/pgx_groups.txt"
    output:
        alleles="results/pgx/af/{gene}_alleles.csv",
        genotypes="results/pgx/af/{gene}_genotypes.csv",
        phenotypes="results/pgx/af/{gene}_phenotypes.csv"
    run:
        import pypgx
        
        # 1. Load sample to group mapping
        sample_groups = {}
        all_groups = set(["ALL"])
        with open(input.groups, 'r') as f:
            for line in f:
                sid, groups_str = line.strip().split('\t')
                groups = groups_str.split(',')
                sample_groups[sid] = groups + ["ALL"]
                for g in groups:
                    all_groups.add(g)
        
        all_groups = sorted(list(all_groups))

        with zipfile.ZipFile(input.zip, 'r') as zip_ref:
            tsv_path = next((f for f in zip_ref.namelist() if f.endswith('data.tsv')), None)
            if not tsv_path:
                return

            with zip_ref.open(tsv_path) as tsv_file:
                df = pd.read_csv(io.StringIO(tsv_file.read().decode('utf-8')), sep="\t")
            
            # Prepare files
            f_alleles = open(output.alleles, 'w', newline='')
            f_genotypes = open(output.genotypes, 'w', newline='')
            f_phenotypes = open(output.phenotypes, 'w', newline='')
            
            w_alleles = csv.writer(f_alleles)
            w_genotypes = csv.writer(f_genotypes)
            w_phenotypes = csv.writer(f_phenotypes)
            
            w_alleles.writerow(["Gene", "Group", "Allele", "Function", "AC", "AN", "AF"])
            w_genotypes.writerow(["Gene", "Group", "Genotype", "Phenotype", "Count", "Frequency"])
            w_phenotypes.writerow(["Gene", "Group", "Phenotype", "Count", "Frequency"])

            for group in all_groups:
                # Subset samples for this group
                if group == "ALL":
                    subset_df = df
                else:
                    group_samples = [sid for sid, groups in sample_groups.items() if group in groups]
                    subset_df = df[df['Sample'].isin(group_samples)]
                
                if subset_df.empty:
                    continue
                
                total_samples = len(subset_df)
                an = total_samples * 2

                # --- Phenotypes ---
                pheno_counts = subset_df["Phenotype"].value_counts().reset_index()
                for _, row in pheno_counts.iterrows():
                    w_phenotypes.writerow([wildcards.gene, group, row['Phenotype'], row['count'], row['count']/total_samples])

                # --- Genotypes ---
                gt_counts = subset_df.groupby(["Genotype", "Phenotype"]).size().reset_index(name='count')
                for _, row in gt_counts.iterrows():
                    w_genotypes.writerow([wildcards.gene, group, row['Genotype'], row['Phenotype'], row['count'], row['count']/total_samples])

                # --- Alleles ---
                all_alleles = []
                for genotype in subset_df["Genotype"]:
                    all_alleles.extend(genotype.replace('|', '/').split('/'))
                
                al_counts = pd.Series(all_alleles).value_counts().reset_index()
                al_counts.columns = ["Allele", "AC"]
                for _, row in al_counts.iterrows():
                    allele = row['Allele']
                    ac = row['AC']
                    try:
                        function = pypgx.get_function(wildcards.gene, allele)
                    except:
                        function = "Unknown"
                    w_alleles.writerow([wildcards.gene, group, allele, function, ac, an, ac/an])

            f_alleles.close()
            f_genotypes.close()
            f_phenotypes.close()

rule merge_alleles:
    input: expand("results/pgx/af/{gene}_alleles.csv", gene=GENES)
    output: "results/pgx/merged_alleles.csv"
    run: pd.concat([pd.read_csv(f) for f in input]).to_csv(output[0], index=False)

rule merge_genotypes:
    input: expand("results/pgx/af/{gene}_genotypes.csv", gene=GENES)
    output: "results/pgx/merged_genotypes.csv"
    run: pd.concat([pd.read_csv(f) for f in input]).to_csv(output[0], index=False)

rule merge_phenotypes:
    input: expand("results/pgx/af/{gene}_phenotypes.csv", gene=GENES)
    output: "results/pgx/merged_phenotypes.csv"
    run: pd.concat([pd.read_csv(f) for f in input]).to_csv(output[0], index=False)
